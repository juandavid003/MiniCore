@{
    ViewBag.Title = "Gestión de Gastos";
}

<main>
    <section class="row" aria-labelledby="pageTitle">
        <h1 id="pageTitle">Gestión de Gastos</h1>
        <p class="lead">Sistema para administrar empleados, departamentos y gastos.</p>
    </section>

    <div class="row mt-4">
        <!-- Filtrar gastos -->
        <section class="col-md-12" aria-labelledby="filtrarGastosTitle">
            <h2 id="filtrarGastosTitle">Filtrar Gastos</h2>
            <form id="formFiltrarGastos" method="get" action="/Gastos/FiltrarGastos">
                <label for="fechaInicio">Fecha Inicio:</label>
                <input type="date" id="fechaInicio" name="fechaInicio" class="form-control" required />
                <label for="fechaFin" class="mt-2">Fecha Fin:</label>
                <input type="date" id="fechaFin" name="fechaFin" class="form-control" required />
                <button type="submit" class="btn btn-primary mt-2">Filtrar</button>
            </form>

            <!-- Mostrar los resultados filtrados en una tabla -->
            @if (ViewBag.Gastos != null && ((List<GastoModel>)ViewBag.Gastos).Count > 0)
            {
                <table class="table table-striped mt-4">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Fecha</th>
                            <th>Descripción</th>
                            <th>Monto</th>
                            <th>Empleado</th>
                            <th>Departamento</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var gasto in ViewBag.Gastos)
                        {
                            <tr>
                                <td>@gasto.Id</td>
                                <td>@gasto.Fecha.ToString("yyyy-MM-dd")</td>
                                <td>@gasto.Descripcion</td>
                                <td>@gasto.Monto.ToString("C2")</td>
                                <td>@gasto.Empleado</td>
                                <td>@gasto.Departamento</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="mt-3">
                    <strong>Monto Total:</strong> @ViewBag.MontoTotal.ToString("C2")
                </div>
            }
            else if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-4">@ViewBag.Error</div>
            }
            else
            {
                <div class="alert alert-info mt-4">No se encontraron gastos para las fechas seleccionadas.</div>
            }




        </section>
    </div>
</main>
