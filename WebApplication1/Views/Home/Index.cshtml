@{
    ViewBag.Title = "Gestión de Gastos";
}

<main>
    <section class="row" aria-labelledby="pageTitle">
        <h1 id="pageTitle">Gestión de Gastos</h1>
        <p class="lead">Sistema para administrar empleados, departamentos y gastos.</p>
    </section>

    <div class="row">
        <!-- Sección para empleados -->
        <section class="col-md-4" aria-labelledby="empleadosTitle">
            <h2 id="empleadosTitle">Empleados</h2>
            <form id="formEmpleado" method="post" action="/Gastos/CrearEmpleado">
                <label for="idEmpleado">ID del empleado:</label>
                <input type="number" id="idEmpleado" name="id" class="form-control" required />
                <label for="nombreEmpleado">Nombre del empleado:</label>
                <input type="text" id="nombreEmpleado" name="nombre" class="form-control" required />
                <button type="submit" class="btn btn-primary mt-2">Crear Empleado</button>
            </form>
            <form id="formEliminarEmpleado" method="post" action="/Gastos/EliminarEmpleado" class="mt-3">
                <label for="idEmpleadoEliminar">ID del empleado:</label>
                <input type="number" id="idEmpleadoEliminar" name="id" class="form-control" required />
                <button type="submit" class="btn btn-danger mt-2">Eliminar Empleado</button>
            </form>
        </section>

        <!-- Sección para departamentos -->
        <section class="col-md-4" aria-labelledby="departamentosTitle">
            <h2 id="departamentosTitle">Departamentos</h2>
            <form id="formDepartamento" method="post" action="/Gastos/CrearDepartamento">
                <label for="idDepartamento">ID del departamento:</label>
                <input type="number" id="idDepartamento" name="id" class="form-control" required />
                <label for="nombreDepartamento">Nombre del departamento:</label>
                <input type="text" id="nombreDepartamento" name="nombre" class="form-control" required />
                <button type="submit" class="btn btn-primary mt-2">Crear Departamento</button>
            </form>
            <form id="formEliminarDepartamento" method="post" action="/Gastos/EliminarDepartamento" class="mt-3">
                <label for="idDepartamentoEliminar">ID del departamento:</label>
                <input type="number" id="idDepartamentoEliminar" name="id" class="form-control" required />
                <button type="submit" class="btn btn-danger mt-2">Eliminar Departamento</button>
            </form>
        </section>

        <!-- Sección para gastos -->
        <section class="col-md-4" aria-labelledby="gastosTitle">
            <h2 id="gastosTitle">Gastos</h2>
            <form id="formGasto" method="post" action="/Gastos/CrearGasto">
                <label for="fechaGasto">Fecha del gasto:</label>
                <input type="date" id="fechaGasto" name="fecha" class="form-control" required />
                <label for="descripcionGasto" class="mt-2">Descripción:</label>
                <input type="text" id="descripcionGasto" name="descripcion" class="form-control" required />
                <label for="montoGasto" class="mt-2">Monto:</label>
                <input type="number" id="montoGasto" name="monto" class="form-control" step="0.01" required />
                <label for="idEmpleadoGasto" class="mt-2">ID del empleado:</label>
                <input type="number" id="idEmpleadoGasto" name="idEmpleado" class="form-control" required />
                <label for="idDepartamentoGasto" class="mt-2">ID del departamento:</label>
                <input type="number" id="idDepartamentoGasto" name="idDepartamento" class="form-control" required />
                <button type="submit" class="btn btn-primary mt-2">Crear Gasto</button>
            </form>
            <form id="formEliminarGasto" method="post" action="/Gastos/EliminarGasto" class="mt-3">
                <label for="idGastoEliminar">ID del gasto:</label>
                <input type="number" id="idGastoEliminar" name="id" class="form-control" required />
                <button type="submit" class="btn btn-danger mt-2">Eliminar Gasto</button>
            </form>
        </section>
    </div>

    <div class="row mt-4">
        <!-- Filtrar gastos -->
        <section class="col-md-12" aria-labelledby="filtrarGastosTitle">
            <h2 id="filtrarGastosTitle">Filtrar Gastos</h2>
            <form id="formFiltrarGastos" method="get" action="/Gastos/FiltrarGastos">
                <label for="fechaInicio">Fecha Inicio:</label>
                <input type="date" id="fechaInicio" name="fechaInicio" class="form-control" required />
                <label for="fechaFin" class="mt-2">Fecha Fin:</label>
                <input type="date" id="fechaFin" name="fechaFin" class="form-control" required />
                <button type="submit" class="btn btn-primary mt-2">Filtrar</button>
            </form>
        </section>
    </div>
</main>
